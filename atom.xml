---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text">{{ site.title }}</title>
  <link rel="self" type="application/atom+xml" href="{{ '/atom.xml' | absolute_url }}" />
  <link href="{{ '/' | absolute_url }}" />
  <id>{{ '/' | absolute_url }}</id>
  <updated>{{ site.time | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
  <author><name>{{ site.author }}</name></author>
  {% for post in site.posts limit:10 %}
    <entry>
      <title type="text">{{ post.title | xml_escape }}</title>
      <link rel="alternate" type="text/html" href="{{ post.url | absolute_url }}" />
      <id>{{ post.url | absolute_url }}</id>
      <published>{{ post.date | date: "%Y-%m-%dT%H:%M:%SZ" }}</published>
      <updated>{{ post.date | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
      <content type="html">{{ post.content | xml_escape }}</content>
    </entry>
  {% endfor %}
</feed>
